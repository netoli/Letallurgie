  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::RamasserIndice
  titre: Poster de recrutement
  description: "Une affiche de recrutement pour la brigade masqu\xE9e. "
  insight: "Le Maire Polivi\xE8re devient d\xE9sesp\xE9r\xE9, il a besoin de personnel.
    Et l'adresse de leur \xE9v\xE9nement de recrutement est... un vieux manoir abandonn\xE9
    au fond du village? Qu'est-ce qu'ils font l\xE0 bas?"
  img: {fileID: 21300000, guid: da4eb09db56841241b025667646b37ee, type: 3}
  sonRamasser: {fileID: 8300000, guid: 213de7bc57dbd8b4f920cdfeae2ccbfe, type: 3}
