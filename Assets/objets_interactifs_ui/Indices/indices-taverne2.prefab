--- !u!114 &8773080382705359352
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 6927046988931332082}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f78bfdd03640af745a0171a3f855f488, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::RamasserIndice
  titre: Morceau de balance
  description: "Un plateau en laiton noirci, fendu net en son centre. La cha\xEEne
    de suspension est l\xE0, mais elle a \xE9t\xE9 tranch\xE9e, pas rompue. Le bord
    est gauchi par une chaleur intense, et des griffures profondes marquent la surface
    int\xE9rieure, comme si quelque chose avait \xE9t\xE9 pes\xE9 de force contre
    sa volont\xE9."
  insight: "La balance n'a pas c\xE9d\xE9 sous le poids. On l'a bris\xE9e. Quelqu'un
    voulait s'assurer qu'elle ne puisse plus jamais trancher entre deux c\xF4t\xE9s."
  img: {fileID: 21300000, guid: 3bf443c7bee71004aa21e9e05abad484, type: 3}
  sonRamasser: {fileID: 8300000, guid: 3d692ceca3e2fbc4cbea3ecacb407ba6, type: 3}
