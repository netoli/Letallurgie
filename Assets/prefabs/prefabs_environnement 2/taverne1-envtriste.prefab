--- !u!114 &7100074368463433848
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 5326881238757215760}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0dce85f244dd5f84891f3e88809bb98e, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::DialogueTuto
  etapes:
  - repliques:
    - interlocuteur: "Villageois myst\xE9rieux"
      texte: Je n'y crois pas! Le tavernier!
      clipAudio: {fileID: 8300000, guid: 35e3c2aae8ef25b4c9eeace54ed7e1ea, type: 3}
      duree: 3
      pauseApres: 0.2
      idActionADeclencher: 
    - interlocuteur: "Villageois myst\xE9rieux"
      texte: Je le connais depuis qu'il est tout petit.
      clipAudio: {fileID: 0}
      duree: 3
      pauseApres: 0.2
      idActionADeclencher: 
    - interlocuteur: "Villageois myst\xE9rieux"
      texte: "JAMAIS je n'aurais pens\xE9..."
      clipAudio: {fileID: 0}
      duree: 4
      pauseApres: 0.2
      idActionADeclencher: 
    - interlocuteur: "Villageois myst\xE9rieux"
      texte: Que le tavernier serait un criminel!
      clipAudio: {fileID: 0}
      duree: 4
      pauseApres: 0.4
      idActionADeclencher: 
    idActionAuDebut: 
    idActionAFin: dialogue_pnj_mysterieux_fini
  gestionSousTitreRef: {fileID: 0}
  audioSourceVoix: {fileID: 0}
  bufferApresClip: 0.15
  interactifAuDemarrage: 1
  delaiFermetureTuileEsc: 3
