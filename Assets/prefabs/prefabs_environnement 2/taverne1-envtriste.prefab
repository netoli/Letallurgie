  m_Script: {fileID: 11500000, guid: f78bfdd03640af745a0171a3f855f488, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::RamasserIndice
  titre: "Int\xE9ressante conversation"
  description: "Personne ne conna\xEEt l'\xE2ge de l'habitu\xE9 de la taverne. Tout
    ce qu'on sait, c'est qu'il a tout vu, et que ses potins valent de l'or. "
  insight: "Les citoyens font confiance au Maire Polivi\xE8re, mais ils commencent
    \xE0 douter depuis qu'il s'en est pris au tavernier, un pilier de la communaut\xE9.
    Si lui peut dispara\xEEtre, n'importe qui peut dispara\xEEtre."
  img: {fileID: 21300000, guid: 80d20e177198b814fbecc3be598bc439, type: 3}
  sonRamasser: {fileID: 0}
